+// Python getters. `Card` is a `pyclass` but had no `pymethods`, so it
+// reached Python as an opaque object. `rank_index`/`suit_index` are the
+// ergonomic path: `Value`/`Suit` are `pyclass(eq)` without `eq_int`, so
+// Python cannot turn them into integers on its own.
+#[cfg(feature = "python")]
+#[pymethods]
+impl Card {
+    #[getter]
+    fn get_value(&self) -> Value {
+        self.value
+    }
+
+    #[getter]
+    fn get_suit(&self) -> Suit {
+        self.suit
+    }
+
+    #[getter]
+    fn get_id(&self) -> usize {
+        self.id
+    }
+
+    #[getter]
+    fn get_edition(&self) -> Edition {
+        self.edition
+    }
+
+    #[getter]
+    fn get_enhancement(&self) -> Option<Enhancement> {
+        self.enhancement
+    }
+
+    #[getter]
+    fn get_seal(&self) -> Option<Seal> {
+        self.seal
+    }
+
+    /// 0..=12 for Two..=Ace.
+    #[getter]
+    fn get_rank_index(&self) -> usize {
+        match self.value {
+            Value::Two => 0,
+            Value::Three => 1,
+            Value::Four => 2,
+            Value::Five => 3,
+            Value::Six => 4,
+            Value::Seven => 5,
+            Value::Eight => 6,
+            Value::Nine => 7,
+            Value::Ten => 8,
+            Value::Jack => 9,
+            Value::Queen => 10,
+            Value::King => 11,
+            Value::Ace => 12,
+        }
+    }
+
+    /// 0..=3 for Spade, Club, Heart, Diamond.
+    #[getter]
+    fn get_suit_index(&self) -> usize {
+        match self.suit {
+            Suit::Spade => 0,
+            Suit::Club => 1,
+            Suit::Heart => 2,
+            Suit::Diamond => 3,
+        }
+    }
+
+    /// Base chip contribution of this rank.
+    #[getter]
+    fn get_chips(&self) -> usize {
+        self.chips()
+    }
+
+    #[getter]
+    fn get_is_face_card(&self) -> bool {
+        self.is_face_card()
+    }
+
+    /// Enhancement name, or `None`. Convenience for Python callers that
+    /// only want a string and not the `Enhancement` pyclass.
+    #[getter]
+    fn get_enhancement_name(&self) -> Option<String> {
+        self.enhancement.map(|e| format!("{:?}", e))
+    }
+
+    fn __repr__(&self) -> String {
+        card_display(self)
+    }
+
+    fn __str__(&self) -> String {
+        format!("{}", self)
+    }
+}
